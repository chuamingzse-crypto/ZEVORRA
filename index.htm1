<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ZEVORA | Gaming Top Up</title>

<style>
*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  font-family:Arial,Helvetica,sans-serif;
  scroll-behavior:smooth
}

body{
  background:#070707;
  color:#fff
}

a{
  text-decoration:none;
  color:inherit
}

.navbar{
  position:sticky;
  top:0;
  z-index:999;
  background:rgba(5,5,5,.92);
  backdrop-filter:blur(15px);
  border-bottom:1px solid #222
}

.nav-inner{
  max-width:1200px;
  margin:auto;
  padding:18px 25px;
  display:flex;
  align-items:center;
  justify-content:space-between
}

.logo{
  font-size:28px;
  font-weight:900;
  letter-spacing:4px
}

.logo span{
  color:#aaa
}

.nav-links{
  display:flex;
  gap:25px;
  font-size:14px;
  color:#ccc
}

.nav-links a:hover{
  color:#fff
}

.hero{
  min-height:680px;
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  padding:80px 20px;
  background:radial-gradient(circle at 50% 20%,#333 0%,#111 35%,#050505 75%)
}

.hero-content{
  max-width:850px
}

.hero-small{
  color:#aaa;
  letter-spacing:5px;
  font-size:13px;
  margin-bottom:20px
}

.hero h1{
  font-size:78px;
  letter-spacing:12px;
  font-weight:900;
  margin-bottom:20px
}

.hero p{
  color:#bbb;
  font-size:18px;
  line-height:1.7;
  margin-bottom:35px
}

.buttons{
  display:flex;
  justify-content:center;
  gap:15px;
  flex-wrap:wrap
}

.btn{
  display:inline-block;
  padding:15px 28px;
  border-radius:8px;
  font-weight:bold;
  transition:.25s;
  cursor:pointer
}

.btn-main{
  background:#fff;
  color:#000
}

.btn-dark{
  border:1px solid #444;
  color:#fff
}

section{
  max-width:1200px;
  margin:auto;
  padding:90px 25px
}

.section-title{
  text-align:center;
  margin-bottom:45px
}

.section-title small{
  color:#777;
  letter-spacing:4px
}

.section-title h2{
  font-size:40px;
  margin-top:10px
}

.games{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:20px
}

.game-card{
  background:#101010;
  border:1px solid #292929;
  padding:35px;
  border-radius:16px
}

.game-icon{
  font-size:42px;
  margin-bottom:20px
}

.game-card h3{
  font-size:25px;
  margin-bottom:10px
}

.game-card p{
  color:#999;
  line-height:1.6
}

.price-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:18px
}

.price-card{
  background:linear-gradient(145deg,#151515,#090909);
  border:1px solid #2c2c2c;
  border-radius:14px;
  padding:25px;
  text-align:center
}

.price-card .uc{
  color:#aaa;
  font-size:15px;
  margin-bottom:8px
}

.price-card .price{
  font-size:30px;
  font-weight:900;
  margin-bottom:20px
}

.order-btn{
  width:100%;
  border:0;
  padding:12px;
  border-radius:7px;
  background:#fff;
  color:#000;
  font-weight:bold;
  cursor:pointer
}

.notice{
  margin-top:25px;
  text-align:center;
  color:#777;
  font-size:13px
}

.about{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:50px;
  align-items:center
}

.about-box{
  background:#101010;
  border:1px solid #292929;
  padding:35px;
  border-radius:16px
}

.about h2{
  font-size:38px;
  margin-bottom:20px
}

.about p{
  color:#aaa;
  line-height:1.8
}

.features{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:20px
}

.feature{
  padding:30px;
  background:#101010;
  border:1px solid #292929;
  border-radius:15px
}

.feature-number{
  font-size:35px;
  font-weight:900;
  color:#555;
  margin-bottom:20px
}

.feature h3{
  margin-bottom:10px
}

.feature p{
  color:#888;
  line-height:1.6
}

.steps{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:15px
}

.step{
  text-align:center;
  padding:30px 20px;
  border:1px solid #292929;
  border-radius:15px;
  background:#0d0d0d
}

.step-number{
  width:50px;
  height:50px;
  display:flex;
  align-items:center;
  justify-content:center;
  margin:0 auto 20px;
  border-radius:50%;
  background:#fff;
  color:#000;
  font-weight:900
}

.step p{
  color:#888;
  margin-top:10px;
  font-size:14px
}

.payment{
  background:#0c0c0c;
  border:1px solid #292929;
  border-radius:20px;
  padding:50px;
  text-align:center
}

.payment h2{
  font-size:35px;
  margin-bottom:10px
}

.payment p{
  color:#888;
  margin-bottom:30px
}

.qr-wrap{
  background:#fff;
  display:inline-block;
  padding:12px;
  border-radius:15px;
  max-width:390px
}

.qr-wrap img{
  display:block;
  width:100%;
  max-width:360px;
  height:auto;
  border-radius:8px
}

.payment-name{
  margin-top:20px;
  font-size:20px;
  font-weight:bold
}

.phone{
  color:#aaa;
  margin-top:8px
}

.faq{
  max-width:850px;
  margin:auto
}

details{
  background:#101010;
  border:1px solid #292929;
  border-radius:10px;
  margin-bottom:12px;
  padding:20px
}

summary{
  cursor:pointer;
  font-weight:bold
}

details p{
  color:#888;
  line-height:1.7;
  padding-top:15px
}

.cta{
  text-align:center;
  background:radial-gradient(circle,#252525,#080808 65%);
  border-radius:20px;
  border:1px solid #292929;
  padding:80px 30px
}

.cta h2{
  font-size:45px;
  margin-bottom:15px
}

.cta p{
  color:#888;
  margin-bottom:30px
}

footer{
  border-top:1px solid #222;
  padding:35px 25px;
  text-align:center;
  color:#666
}

footer strong{
  color:#fff;
  letter-spacing:3px
}

.float-wa{
  position:fixed;
  right:20px;
  bottom:20px;
  z-index:1000;
  background:#fff;
  color:#000;
  padding:15px 20px;
  border-radius:50px;
  font-weight:bold
}

@media(max-width:800px){

.nav-links{
  display:none
}

.hero{
  min-height:600px
}

.hero h1{
  font-size:45px;
  letter-spacing:7px
}

.hero p{
  font-size:15px
}

.games,
.price-grid,
.features,
.steps{
  grid-template-columns:1fr
}

.about{
  grid-template-columns:1fr
}

section{
  padding:65px 18px
}

.section-title h2{
  font-size:32px
}

.payment{
  padding:30px 15px
}

.qr-wrap{
  max-width:100%
}

.cta h2{
  font-size:32px
}

.float-wa{
  right:15px;
  bottom:15px;
  padding:13px 16px
}

}
</style>
</head>

<body>

