<a
class="float-wa"
href="https://wa.me/60175314055?text=Hi%20ZEVORA%2C%20我想咨询充值"
target="_blank">
💬 WhatsApp
</a>

<script>

function order(item,price){

const message =
"Hi ZEVORA 👋\n\n"+
"我想下单\n"+
"项目："+item+"\n"+
"价格："+price+
"\n\n请告诉我下一步，谢谢！";

window.open(
"https://wa.me/60175314055?text="+
encodeURIComponent(message),
"_blank"
);

}

</script>

